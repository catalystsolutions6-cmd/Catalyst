{
  "expo": {
    "name": "Catalyst Seller",
    "slug": "catalyst-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.catalystsolutions.seller"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.catalystsolutions.seller",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow the app to use your camera to photograph products for listings.",
          "photosPermission": "Allow the app to pick product photos from your gallery."
        }
      ]
    ],
    "scheme": "catalystseller",
    "extra": {
      "apiUrl": "https://catalyst-37cd.vercel.app",
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "7493a001-e0bb-4229-9665-f4e4e826aa53"
      }
    },
    "owner": "catalystsolutions"
  }
}
