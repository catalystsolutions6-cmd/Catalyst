# Database. Dev uses SQLite; production needs Postgres (see README "Deploy to Vercel").
DATABASE_URL="file:./dev.db"

# Admin panel login (change in production)
ADMIN_EMAIL="admin@catsols.com"
ADMIN_PASSWORD="admin123"

# AI photo-to-listing (Google Gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: pick a model (default gemini-flash-latest)
# GEMINI_MODEL=""

# ---- Product photo storage: set ONE of these. With neither, photos are saved to local disk (dev only). ----
# Vercel Blob: added automatically when you connect a Blob store to the project in Vercel (Storage tab).
BLOB_READ_WRITE_TOKEN=""
# Cloudinary: copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=""
# Optional: force a backend (vercel-blob | cloudinary | local) and choose the folder name in storage.
# STORAGE_DRIVER=""
UPLOAD_FOLDER="products"
# Local-disk folder used only when no cloud storage is configured.
UPLOAD_DIR="./uploads"
